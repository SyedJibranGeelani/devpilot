# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "openai" or "watsonx"
LLM_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-13b-chat-v2

# ── Analysis Limits ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_KB=500
MAX_FILES_PER_ANALYSIS=100
