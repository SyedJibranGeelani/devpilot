# Frontend environment configuration
# Copy this file to .env and set the values for your environment.
# Do NOT commit .env — it is listed in .gitignore.

# Backend API base URL.
# Set to the deployed backend URL for production builds.
# Omit (or leave unset) for local development — the app will fall back to http://localhost:8000.
VITE_API_URL=https://devpilot-1-0iai.onrender.com
